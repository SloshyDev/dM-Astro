---
interface Props {
  title: string;
  subtitle: string;
  image: string;
  audioSource?: string;
  eyebrow?: string;
  backgroundImage?: string;
}

const { title, subtitle, image, audioSource = "", eyebrow = "ENTREVISTA", backgroundImage } = Astro.props;
---

<article
  data-audio-player
  data-audio-source={audioSource}
  style={backgroundImage ? `background-image: linear-gradient(rgb(10 54 58 / 10%), rgb(10 54 58 / 92%)), url('${backgroundImage}')` : undefined}
  class="border-green/60 w-[min(92vw,48rem)] rounded-3xl border bg-[#10373a] bg-cover bg-center p-6 text-white shadow-2xl sm:p-10">
  <div class="flex items-center gap-5">
    <img class="h-22 w-22 shrink-0 rounded-full object-cover sm:h-38 sm:w-38" src={image} alt={title} />
    <div class="min-w-0">
      <p class="text-teal-dark text-md font-bold tracking-[0.2em]">{eyebrow}</p>
      <h2 class="font-myriad-condensed mt-1 text-3xl leading-none font-black uppercase sm:text-5xl">{title}</h2>
      <p class="font-myriad-condensed text-lg font-bold sm:text-2xl">{subtitle}</p>
    </div>
  </div>

  <audio data-player-audio preload="metadata"></audio>

  <div class="mt-8">
    <input
      data-player-progress
      class="audio-progress w-full cursor-pointer accent-[#b8cf78]"
      type="range"
      min="0"
      max="0"
      value="0"
      step="0.1"
      aria-label="Progreso del audio"
    />
    <div class="mt-2 flex justify-between text-sm font-bold text-white/80 tabular-nums">
      <span data-player-current>00:00</span>
      <span data-player-duration>00:00</span>
    </div>
  </div>

  <div class="mt-3 flex items-center justify-center gap-5 sm:gap-8">
    <button
      data-player-back
      type="button"
      class="grid h-12 w-12 place-items-center rounded-full border border-white/80 transition hover:border-[#b8cf78] hover:text-[#b8cf78]"
      aria-label="Retroceder 15 segundos">
      <span class="text-sm font-bold">↶15</span>
    </button>
    <button
      data-player-toggle
      type="button"
      class="grid h-18 w-18 place-items-center rounded-full bg-[#9bb850] text-[#10373a] shadow-lg transition hover:scale-105"
      aria-label="Reproducir audio">
      <svg data-player-play-icon viewBox="0 0 24 24" class="ml-1 h-9 w-9 fill-current" aria-hidden="true"><path d="M7 5.5v13l11-6.5z"></path></svg>
      <svg data-player-pause-icon viewBox="0 0 24 24" class="hidden h-9 w-9 fill-current" aria-hidden="true"><path d="M7 5h4v14H7zm6 0h4v14h-4z"></path></svg>
    </button>
    <button
      data-player-forward
      type="button"
      class="grid h-12 w-12 place-items-center rounded-full border border-white/80 transition hover:border-[#b8cf78] hover:text-[#b8cf78]"
      aria-label="Adelantar 15 segundos">
      <span class="text-sm font-bold">15↷</span>
    </button>
  </div>
</article>

<script>
  const formatTime = (seconds: number) => {
    if (!Number.isFinite(seconds)) return "00:00";

    const minutes = Math.floor(seconds / 60);
    const remainingSeconds = Math.floor(seconds % 60)
      .toString()
      .padStart(2, "0");

    return `${minutes.toString().padStart(2, "0")}:${remainingSeconds}`;
  };

  document.querySelectorAll<HTMLElement>("[data-audio-player]").forEach((player) => {
    const audio = player.querySelector<HTMLAudioElement>("[data-player-audio]");
    const progress = player.querySelector<HTMLInputElement>("[data-player-progress]");
    const toggle = player.querySelector<HTMLButtonElement>("[data-player-toggle]");
    const back = player.querySelector<HTMLButtonElement>("[data-player-back]");
    const forward = player.querySelector<HTMLButtonElement>("[data-player-forward]");
    const current = player.querySelector<HTMLElement>("[data-player-current]");
    const duration = player.querySelector<HTMLElement>("[data-player-duration]");
    const playIcon = player.querySelector<SVGElement>("[data-player-play-icon]");
    const pauseIcon = player.querySelector<SVGElement>("[data-player-pause-icon]");
    const source = player.dataset.audioSource;

    if (!audio || !progress || !toggle || !back || !forward || !current || !duration || !playIcon || !pauseIcon) return;

    if (source) audio.src = source;

    const syncPlayState = () => {
      playIcon.classList.toggle("hidden", !audio.paused);
      pauseIcon.classList.toggle("hidden", audio.paused);
      toggle.setAttribute("aria-label", audio.paused ? "Reproducir audio" : "Pausar audio");
    };

    toggle.addEventListener("click", () => {
      if (!audio.src) return;
      if (audio.paused) audio.play();
      else audio.pause();
    });

    audio.addEventListener("loadedmetadata", () => {
      progress.max = audio.duration.toString();
      duration.textContent = formatTime(audio.duration);
    });

    audio.addEventListener("timeupdate", () => {
      progress.value = audio.currentTime.toString();
      current.textContent = formatTime(audio.currentTime);
    });

    audio.addEventListener("play", syncPlayState);
    audio.addEventListener("pause", syncPlayState);
    audio.addEventListener("ended", syncPlayState);
    progress.addEventListener("input", () => (audio.currentTime = Number(progress.value)));
    back.addEventListener("click", () => (audio.currentTime = Math.max(0, audio.currentTime - 15)));
    forward.addEventListener("click", () => (audio.currentTime = Math.min(audio.duration || 0, audio.currentTime + 15)));
  });
</script>
