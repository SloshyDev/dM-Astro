---
import "@splidejs/splide/css/core";
import { getAbsoluteUrl } from "../../utils/media";
const { reports } = Astro.props;

console.log(reports.data_contents);
---

<section class="border-teal-mid mx-auto w-[93.5%] rounded-2xl border-10 bg-zinc-200 p-4">
  <h2 class="font-myriad-condensed text-center text-[2vw] leading-none font-semibold text-zinc-700">
    EXPLORE OUR STUDIES AND TECHNICAL REPORTS ON <br />
    <span class="text-[3vw]">BIODIVERSITY AND FISHERIES</span>
  </h2>
  <p class="mx-auto my-4 w-4/5 text-center text-[1.2vw] leading-none text-zinc-700">
    Sharing advances and findings from scientific work is one of the Gulf of California Marine Program’s and its collaborators' commitments. Dive into the
    digital library and discover what scientists are uncovering through their research projects.
  </p>

  <section id="" class="carrouselReports splide my-12" aria-label="Splide Basic HTML Example">
    <div class="splide__track mx-12">
      <ul class="splide__list">
        {
          reports.data_contents.map((report) => {
            return (
              <li class="splide__slide">
                <img class="mx-auto rounded-2xl" src={getAbsoluteUrl(report.Poster.url)} alt="" />
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</section>

<script>
  import Splide from "@splidejs/splide";

  document.addEventListener("DOMContentLoaded", () => {
    const carrouselBanners = document.querySelector(".carrouselReports") as HTMLElement | null;

    if (carrouselBanners) {
      const heightRatioAttr = carrouselBanners.dataset.heightRatio;
      const heightRatio = heightRatioAttr ? parseFloat(heightRatioAttr) : undefined;

      new Splide(carrouselBanners, {
        type: "loop",
        pauseOnHover: true,
        pagination: false,
        perPage: 4,
        autoplay: true,
        arrowPath: "M8 8 17 20 8 32M22 8l9 12-9 12",
        ...(heightRatio ? { heightRatio } : {}),
      }).mount();
    }
  });
</script>
