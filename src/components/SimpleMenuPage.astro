---
const { title, section, scientificName, lang = "en" } = Astro.props;
const eyebrow = section ?? (lang === "es" ? "dataMares" : "dataMares");
const description =
  lang === "es"
    ? "Página simple creada como punto de partida para este contenido del menú."
    : "Simple page created as a starting point for this menu content.";
const status = lang === "es" ? "Contenido en desarrollo" : "Content in progress";
---

<main class="mx-auto flex min-h-[70vh] max-w-5xl flex-col justify-center px-6 py-20">
  <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-[#316663] dark:text-[#70b7b1]">{eyebrow}</p>
  <h1 class="max-w-3xl text-4xl font-semibold text-gray-900 dark:text-gray-100 md:text-6xl">{title}</h1>
  {scientificName && <p class="mt-4 text-xl italic text-[#316663] dark:text-[#70b7b1]">{scientificName}</p>}
  <p class="mt-6 max-w-2xl text-lg leading-8 text-gray-600 dark:text-slate-300">{description}</p>
  <div class="mt-8 w-fit rounded-full border border-[#316663]/30 px-4 py-2 text-sm font-medium text-[#316663] dark:border-[#70b7b1]/40 dark:text-[#70b7b1]">
    {status}
  </div>
</main>
