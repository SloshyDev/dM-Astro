---
import Header from "../components/Header/Header";
import BackToTop from "../components/BackToTop.astro";
import Footer from "../components/Footer.astro";
import ThemeSelector from "../components/ThemeSelector";
import ViewPort from "../components/ViewPort";
import "../styles/global.css";

const siteUrl = "https://datamares.org";
const defaultTitle = "dataMares | WORK • PUBLISH • RELEASE";
const defaultDescription =
  "dataMares facilitates access to scientific knowledge and data to promote transparency, education, and evidence-based conservation in Mexico's ecosystems.";
const defaultImage = "/Logo.svg";
const strapiOrigin = import.meta.env.PUBLIC_STRAPI_URL?.replace(/\/$/, "");

const { title = defaultTitle, description = defaultDescription, image = defaultImage, type = "website" } = Astro.props;

const lang = Astro.currentLocale === "es" ? "es" : "en";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://use.typekit.net" />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="preload" href="https://use.typekit.net/kna1chv.css" as="style" />
    <link rel="stylesheet" href="https://use.typekit.net/kna1chv.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://use.typekit.net/kna1chv.css" /></noscript>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="dataMares" />

    <meta property="og:site_name" content="dataMares" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {strapiOrigin && <link rel="preconnect" href={strapiOrigin} crossorigin="anonymous" />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="dataMares logo" />
    <meta property="og:locale" content={lang === "es" ? "es_MX" : "en_US"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline>
      (() => {
        const storageKey = "datamares-theme";
        let preference = "system";

        try {
          const storedTheme = window.localStorage.getItem(storageKey);
          if (["light", "dark", "system"].includes(storedTheme)) preference = storedTheme;
        } catch {
          // Use the system preference when storage is unavailable.
        }

        const theme = preference === "system" ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : preference;

        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body id="top" class="bg-white text-zinc-900 transition-colors duration-150 dark:bg-zinc-900 dark:text-zinc-100">
    <Header client:idle lang={lang} pathname={pathname} />
    <main class="mx-auto min-h-screen">
      <slot />
    </main>
    <Footer lang={lang} />
    <BackToTop lang={lang} />
    <ThemeSelector client:idle />
    <ViewPort client:only />
  </body>
</html>
