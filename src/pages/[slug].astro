---
export const prerender = false;

import SimpleMenuPage from "../components/SimpleMenuPage.astro";
import { getMenuPages } from "../components/Header/menuData";
import Layout from "../layouts/Layout.astro";

const page = getMenuPages("en").find((entry) => entry.slug === Astro.params.slug);

if (!page) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}
---

<Layout title={`${page.label} | dataMares`}>
  <SimpleMenuPage title={page.label} section={page.section} scientificName={page.scientificName} lang="en" />
</Layout>
