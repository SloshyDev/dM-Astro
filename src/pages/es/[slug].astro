---
import SimpleMenuPage from "../../components/SimpleMenuPage.astro";
import { getMenuPages } from "../../components/Header/menuData";
import Layout from "../../layouts/Layout.astro";

/**
 * Generates every Spanish route declared in the menu data.
 *
 * @returns {Array<{params: {slug: string}, props: {page: import("../../components/Header/menuData").MenuPage}}>} Astro static route definitions.
 * @throws {TypeError} If the menu configuration cannot be flattened.
 */
export function getStaticPaths() {
  return getMenuPages("es").map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
---

<Layout title={`${page.label} | dataMares`}>
  <SimpleMenuPage title={page.label} section={page.section} scientificName={page.scientificName} lang="es" />
</Layout>
