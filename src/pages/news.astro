---
export const prerender = false;

import { getNewsData } from "../api/news/getAboutData";
import Banners from "../components/News/Banners.astro";
import Interviews from "../components/News/Interviews.astro";
import NewsVault from "../components/News/NewsVault.astro";
import Reports from "../components/News/Reports.astro";
import Link from "../components/Utils/Link.astro";
import Layout from "../layouts/Layout.astro";
import { getAbsoluteUrl, getImageSrcSet, getLink } from "../utils/media";

const newsGallery = await getNewsData();

const banners = newsGallery.Banners;
const news_vault = newsGallery.News_vault;

const news = newsGallery.News;

const reports = newsGallery.Reports;

const sustainabilityDispatch = news.find((item) => item.Title === "SUSTAINABILITY DISPATCH");
const marineProsperityAreas = news.find((item) => item.Title === "NEW SECTION MARINE PROSPERITY AREAS");
const dataPage = news.find((item) => item.Title === "DATA");
---

<Layout>
  <Banners banners={banners} />
  <section class="max_page mx-2 mb-12 justify-between xl:mx-0 xl:flex">
    <div class="min-h-screen w-full space-y-6 py-6 xl:py-12">
      <NewsVault news_vault={news_vault} />
      <div class="mx-auto px-4 xl:w-[87%] xl:px-0">
        <Link href={sustainabilityDispatch.Link} typeOfLink={sustainabilityDispatch.TypeOfLink}>
          <img
            srcset={getImageSrcSet(sustainabilityDispatch.Image)}
            sizes="auto"
            width={sustainabilityDispatch.Image.width}
            height={sustainabilityDispatch.Image.height}
            class="w-full rounded-md transition-transform duration-300 hover:scale-[.98] xl:rounded-2xl"
            src={getAbsoluteUrl(sustainabilityDispatch.Image.url)}
            alt={sustainabilityDispatch.Title}
          />
        </Link>
      </div>
      <div class="mx-auto px-4 xl:w-[87%] xl:px-0">
        <Link href={marineProsperityAreas.Link} typeOfLink={marineProsperityAreas.TypeOfLink}>
          <img
            srcset={getImageSrcSet(marineProsperityAreas.Image)}
            sizes="auto"
            width={marineProsperityAreas.Image.width}
            height={marineProsperityAreas.Image.height}
            class="w-full rounded-2xl transition-transform duration-300 hover:scale-[.98]"
            src={getAbsoluteUrl(marineProsperityAreas.Image.url)}
            alt={marineProsperityAreas.Title}
          />
        </Link>
      </div>
    </div>
    <div class="bg-teal-mid mx-4 hidden min-h-screen w-5 rounded-b-full xl:block"></div>
    <div class="min-h-screen w-full space-y-6 pb-6 xl:py-12">
      <div
        class="3xl:min-h-266 bg-teal-dark border-teal-mid 3xl:border-12 2xl mx-3 flex min-h-100 flex-col items-center overflow-hidden rounded-2xl border-6 py-4 xl:mx-auto xl:min-h-[40.4vw] xl:w-[87%] xl:rounded-4xl xl:border-[.5vw]">
        <img width="731" height="131" class="mb-8 w-[95%]" src="https://api.sloshy.cloud/uploads/Interviews_Icon_0d34ec2665.svg" alt="Icon interviews" />
        <Interviews news={news} />
      </div>
      <div class="mx-auto px-4 xl:w-[87%] xl:px-0">
        <h3 class="text-green font-myriad-condensed 3xl:text-7xl text-center leading-none font-bold xl:text-[3vw]">DIVE INTO OUR NEW SECTION</h3>
        <h2 class="text-teal font-myriad-condensed 3xl:text-9xl 3xl:leading-none text-center font-bold xl:text-[7vw] xl:leading-[5vw]">DATA</h2>
      </div>

      <div class="mx-auto px-4 xl:w-[87%] xl:px-0">
        <Link href={dataPage.Link} typeOfLink={dataPage.TypeOfLink}>
          <img
            srcset={getImageSrcSet(dataPage.Image)}
            sizes="auto"
            width={dataPage.Image.width}
            height={dataPage.Image.height}
            class="w-full rounded-2xl transition-transform duration-300 hover:scale-[.98]"
            src={getAbsoluteUrl(dataPage.Image.url)}
            alt={dataPage.Title}
          />
        </Link>
      </div>
    </div>
  </section>

  <Reports reports={reports} />
</Layout>
